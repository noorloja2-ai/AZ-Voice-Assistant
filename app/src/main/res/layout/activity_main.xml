<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/az_bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AZ" android:textColor="@color/az_cyan" android:textSize="56sp" android:textStyle="bold" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VOICE ASSISTANT" android:textColor="@color/az_white" android:textSize="22sp" android:textStyle="bold" />
  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@color/az_panel" android:padding="18dp" android:text="বলুন ‘Hey AZ’ অথবা মাইক্রোফোন চাপুন" android:textColor="@color/az_white" android:textSize="18sp" />
  <Button android:id="@+id/listen" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="18dp" android:text="🎙  কথা বলুন / SPEAK" android:textStyle="bold" />
  <Button android:id="@+id/wake" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="12dp" android:text="START HEY AZ" android:textStyle="bold" />
  <EditText android:id="@+id/server" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="Secure AI server URL" android:inputType="textUri" android:textColor="@color/az_white" android:textColorHint="#94A3B8" />
  <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SAVE SECURE SERVER" />
  <Button android:id="@+id/test" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TEST AI CONNECTION" />
  <Button android:id="@+id/remove" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="REMOVE AI CONNECTION" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:gravity="center" android:text="Developed by Anamul Hossain\nSupport: anamul00pt@gmail.com" android:textColor="#94A3B8" />
 </LinearLayout>
</ScrollView>
